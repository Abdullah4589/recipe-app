# Copy to backend/.env (backend vars) and .env (frontend vars), then fill in.
# Never commit the filled-in files — .gitignore covers them, and
# .claude/hooks/guard-write.js blocks writing them from an agent session.

# ─── Backend (backend/.env) ──────────────────────────────────────────────────

# MongoDB Atlas connection string, including credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mealplanner

# Signing key for auth tokens. Use a long random value — `openssl rand -hex 32`.
# Rotating this invalidates every issued token, logging out all users at once
# (there is no refresh-token flow — see docs/DECISIONS.md ADR-004).
JWT_SECRET=

# Optional. Defaults to 3000.
PORT=3000

# ─── Frontend (.env at the repo root) ────────────────────────────────────────

# Which backend the app talks to. Inlined at bundle time by Expo, so a change
# needs a rebuild, not just a restart.
#
#   phone on local wifi : http://192.168.1.5:3000/api   (your LAN IP — never
#                         `localhost`, the phone cannot reach the dev machine's
#                         loopback; find it with `ipconfig`)
#   e2e test runs       : http://localhost:4000/api     (set automatically by
#                         scripts/serve-web.js)
#
# Unset falls back to the deployed Railway URL in api/backend.js.
EXPO_PUBLIC_BACKEND_URL=
